# Flask
FLASK_ENV=development
FLASK_DEBUG=0
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL (required — do not commit real credentials)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=securescan
MYSQL_PASSWORD=
MYSQL_DB=securescan
# Or use a single URL:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/securescan

# JWT — required in production (min 32 random characters)
JWT_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (use Redis in production / Docker)
REDIS_URL=redis://127.0.0.1:6379/0

# PDF reports storage
REPORTS_STORAGE_PATH=./storage/reports

# Optional
# JWT_ACCESS_TOKEN_EXPIRES=900
# DISABLE_SCHEDULER=1

# Gemini AI (optional — enables rich AI analysis and report narratives)
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
