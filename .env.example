# SecureScan AI — root .env.example for Docker Compose
# Copy: cp .env.example .env.docker  and fill in real secrets.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# ── Application ───────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_me_to_64_hex_chars
JWT_SECRET_KEY=change_me_to_64_hex_chars

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=securescan_root
MYSQL_DATABASE=securescan
MYSQL_DB=securescan
MYSQL_USER=securescan
MYSQL_PASSWORD=securescan_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Full connection URL (overrides the individual MYSQL_* vars when set)
DATABASE_URL=mysql+pymysql://securescan:securescan_pass@mysql:3306/securescan

# Optional: publish MySQL on a different host port to avoid conflict with a
# local MySQL instance (default 3307 → container 3306)
MYSQL_PUBLISH_PORT=3307

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Optional: host port for Redis (default 6380 → container 6379)
REDIS_PUBLISH_PORT=6380

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend build ────────────────────────────────────────────────────────────
# Leave empty so nginx inside the container proxies /api → backend service.
# Set to http://localhost:5000 only for local (non-Docker) dev.
VITE_API_BASE_URL=

# ── Backend runtime ───────────────────────────────────────────────────────────
REPORTS_STORAGE_PATH=./storage/reports
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
DISABLE_SCHEDULER=0

# Gemini AI (optional — enables rich AI analysis and PDF report narratives)
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
