# SecureScan AI — Docker Compose environment
# Copy: cp .env.docker .env   OR use: docker compose --env-file .env.docker up -d
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# --- Application ---
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace_with_64_char_hex_secret_for_docker_production_use_only
JWT_SECRET_KEY=replace_with_64_char_hex_jwt_secret_for_docker_production

# --- MySQL (service name: mysql) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=securescan
MYSQL_DB=securescan
MYSQL_USER=securescan
MYSQL_PASSWORD=securescan_pass

# Full URL used by backend (overrides MYSQL_* pieces when set)
DATABASE_URL=mysql+pymysql://securescan:securescan_pass@mysql:3306/securescan

# --- Redis (rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (browser origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend build (empty = nginx proxies /api to backend) ---
VITE_API_BASE_URL=

# --- Backend runtime ---
REPORTS_STORAGE_PATH=/app/storage/reports
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
DISABLE_SCHEDULER=0
